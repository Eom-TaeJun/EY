# Secrets and local settings
.env
CLAUDE.local.md
.claude/settings.local.json

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Data: keep folders, not source or generated data
/data/raw/*
!/data/raw/.gitkeep
/data/interim/*
!/data/interim/.gitkeep
/data/processed/*
!/data/processed/.gitkeep

# Outputs and logs: retain small audit evidence, not large derived binaries
/outputs/*
!/outputs/qa/
!/outputs/final/
/outputs/qa/*
!/outputs/qa/*.json
!/outputs/qa/attempts/
!/outputs/qa/attempts/**
!/outputs/qa/validated/
!/outputs/qa/validated/**
/outputs/final/*
!/outputs/final/*.json
!/outputs/final/*.md
/logs/*
!/logs/ingestion/
/logs/ingestion/*
!/logs/ingestion/*.json

# Local database and office temp files
*.db
*.sqlite
*.xlsx~
~$*.xlsx
~$*.docx
~$*.pptx

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/
